{
  "name": "vtuber-frontend-live2d",
  "version": "0.1.0",
  "private": true,
  "description": "Transparent, always-on-top Live2D Cubism companion overlay (Electron + PixiJS + pixi-live2d-display).",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node electron/launch.js\"",
    "build": "vite build",
    "start": "npm run build && node electron/launch.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@pixi/unsafe-eval": "^6.5.10",
    "lucide": "^1.34.0",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "6.5.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^44.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "vite": "^7.0.0",
    "wait-on": "^8.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
