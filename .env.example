# BotRix multistream chat widget — the exact URL you would add to OBS as a
# browser source (BotRix dashboard → Widgets). It embeds the official widget
# page, which connects to Twitch, YouTube AND Kick chat at once, and the bid
# query parameter doubles as the session id for the viewer-count REST poll.
#
# Get yours at: https://botrix.live (sign in → Widgets → copy the widget URL)
#
# Copy this file to .env and paste your URL. .env is gitignored — the bid is
# a private session identifier, never commit it.
BOTRIX_WIDGET_URL=https://botrix.live/widget/chat/?bid=YOUR_BID_HERE
